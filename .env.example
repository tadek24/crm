# Nazwa jest odseparowana od wszystkich innych projektow Compose na hoście.
COMPOSE_PROJECT_NAME=eprom-crm
CRM_IMAGE_TAG=local

# Wymagany sekret pierwszego utworzenia administratora. Wygeneruj dluga,
# losowa wartosc i zapisz ja tylko w prywatnym pliku .env.
CRM_SETUP_TOKEN=
CRM_TIMEZONE=Europe/Warsaw

# Bezpieczny, opcjonalny podglad lokalny: http://127.0.0.1:4320
CRM_LOCAL_PORT=4320

# Jedyny publiczny adres dopuszczony przez backend CRM.
CRM_ALLOWED_ORIGINS=https://crm.webspanner.pl

# Token umiesc w osobnym pliku zawierajacym tylko wartosc tokenu.
# Nie zapisuj tokenu w tym pliku ani w repozytorium.
CLOUDFLARE_TUNNEL_TOKEN_FILE=./secrets/cloudflare-tunnel-token
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.9.1
CLOUDFLARE_TUNNEL_PROTOCOL=auto
